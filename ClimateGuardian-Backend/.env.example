# ClimateGuardian Backend Environment Variables Template
# Copy this file to .env and configure local values

# Application Configuration
APP_NAME=ClimateGuardian API
APP_ENV=development
DEBUG=True
HOST=127.0.0.1
PORT=8000

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Model and Data Paths
MODEL_PATH=ml/xgboost_model.pkl
CITY_COORDINATES_PATH=data/city_coordinates.csv

# External Open-Meteo Endpoints
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_AIR_QUALITY_URL=https://air-quality-api.open-meteo.com/v1/air-quality
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
